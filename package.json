{
  "name": "raasta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply raasta-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply raasta-db --remote",
    "db:seed:local": "wrangler d1 execute raasta-db --local --file=./seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute raasta-db --remote --file=./seed/seed.sql",
    "seed:build": "node scripts/build-seed.mjs",
    "verify:build": "node scripts/build-verification.mjs",
    "db:verify:local": "wrangler d1 execute raasta-db --local --file=./seed/verification-update.sql",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "workerd@1.20261019.1": true,
    "esbuild@0.28.2": true
  }
}
