{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raasta",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raasta-db",
      // Created 2026-10-25 in region WNAM. Consider D1 read replication / an APAC copy for Pakistan latency.
      "database_id": "a10825fc-cc0f-4972-9282-b2b741f88ab8",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "PAYMENTS_ENABLED": "false",
    "AI_ENABLED": "false"
  },
  // Source-freshness job. Cron times are UTC: every 4 hours at :17 (08:17, 12:17 … PKT). 6 sources per run.
  "triggers": { "crons": ["*/2 * * * *"] },
  "observability": { "enabled": true }
  // Custom domain later: add "routes": [{ "pattern": "raasta.example", "custom_domain": true }]
}
